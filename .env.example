# Copy to .env and fill in. Placeholders only - never commit real values.
NODE_ENV=development
PORT=8787
# Public base URL of the deployed app (used for Origin checks). Must be https:// in production.
APP_URL=http://localhost:5173
# PostgreSQL connection string. If unset in development, an embedded PGlite database is stored in DATA_DIR.
# REQUIRED in production.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Set to "require" when your provider needs TLS (most managed databases do).
DATABASE_SSL=require
DATA_DIR=.data
# Session lifetime in hours.
SESSION_TTL_HOURS=168
# Run retention cleanup every N minutes inside the server process (0 disables; use `npm run retention` from cron instead).
RETENTION_INTERVAL_MINUTES=1440
# Set to 1 only when running behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=0
LOG_LEVEL=info

# --- Offline signed policy bundles (needed for the executor's cloud-outage mode) ---
# Ed25519 private key, PKCS#8 DER, base64. Generate once:  node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# Keep it in your secret manager. If unset in production, /v1/policy-bundle answers 503 and executors fail closed when offline.
POLICY_SIGNING_KEY=base64-pkcs8-ed25519-private-key
# How long a signed bundle stays valid offline (minutes). Shorter = revocation/policy changes reach offline executors sooner.
POLICY_BUNDLE_TTL_MINUTES=240

# --- Enterprise sign-in (docs/ENTERPRISE-AUTH.md) ---
# 32 random bytes, base64. Encrypts authenticator secrets and SSO client secrets in the database. REQUIRED in production.
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=
# "Continue with Google": Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <APP_URL>/api/auth/sso/callback. Leave both empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with Kenuxa Account": on by default with the public values every Kenuxa app shares (set KENUXA_SIGNIN=0 to hide it).
# Register Heimdall in kenuxa_apps once: run KENUXA ACCOUNTS/supabase/migrations/0004_heimdall_sourcebook.sql. Set all three
# below only to point at a different Kenuxa Accounts / Supabase project.
KENUXA_ACCOUNTS_URL=
KENUXA_SUPABASE_URL=
KENUXA_SUPABASE_ANON_KEY=
KENUXA_CLIENT_ID=heimdall

# Email alerts (docs/ALERTS.md). Leave empty to disable email channels.
SMTP_URL=
EMAIL_FROM=Kenuxa Heimdall <alerts@heimdall.local>
