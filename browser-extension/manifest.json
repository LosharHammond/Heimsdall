{
  "manifest_version": 3,
  "name": "Kenuxa Heimdall \u2014 AI Browser Guard",
  "short_name": "Heimdall",
  "version": "1.0.0",
  "description": "Stops passwords, API keys, private keys and card numbers from being pasted or sent into ChatGPT, Claude, Gemini and other AI chats.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://poe.com/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://chat.mistral.ai/*",
    "https://www.meta.ai/*",
    "https://huggingface.co/*",
    "https://aistudio.google.com/*",
    "https://notebooklm.google.com/*",
    "https://kenuxa-heimdall.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Heimdall browser guard",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://www.meta.ai/*",
        "https://huggingface.co/*",
        "https://aistudio.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": [
        "detect.js",
        "guard.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://kenuxa-heimdall.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_start"
    }
  ]
}